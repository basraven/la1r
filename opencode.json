{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "lsp": true,
  "formatter": true,
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "read": {
      "*": "allow",
      "credentials/**": "deny",
      "**/credentials/**": "deny",
      ".env": "deny",
      "**/.env": "deny"
    },
    "bash": {
      "*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push * --force*": "deny",
      "git push * -f*": "deny",
      "git push * +*": "deny",
      "git push *:*": "ask",
      "git reset --hard*": "ask",
      "git clean -*": "ask",
      "git rebase -i*": "ask",
      "rm -rf *": "ask",
      "rm -fr *": "ask",
      "rm *": "ask",
      "terraform destroy*": "ask",
      "terraform apply*": "ask",
      "kubectl delete *": "ask",
      "ansible-playbook*": "ask",
      "./ansible.sh*": "ask"
    }
  }
}
