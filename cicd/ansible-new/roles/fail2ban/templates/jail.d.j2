[{{ item.key }}]
# Managed by Ansible (roles/fail2ban)
enabled = {{ (item.value.enabled | default(true)) | ternary('true', 'false') }}
port = {{ item.value.port | default('ssh') }}
filter = {{ item.value.filter | default(item.key) }}

{% if item.value.backend is defined %}backend = {{ item.value.backend }}
{% endif %}
{% if item.value.logpath is defined %}logpath = {{ item.value.logpath }}
{% endif %}
{% if item.value.journalmatch is defined %}journalmatch = {{ item.value.journalmatch }}
{% endif %}
{% if item.value.maxretry is defined %}maxretry = {{ item.value.maxretry }}
{% endif %}
{% if item.value.findtime is defined %}findtime = {{ item.value.findtime }}
{% endif %}
{% if item.value.bantime is defined %}bantime = {{ item.value.bantime }}
{% endif %}
