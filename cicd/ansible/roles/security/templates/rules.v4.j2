*filter
-A FORWARD -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
# Forward Samba to jay-c (virtual ip for tracking) coming from remote-cube
-A FORWARD -i tun0 -o enp3s0 -p tcp --dport 139 -d 192.168.5.103 -j ACCEPT
-A FORWARD -i tun0 -o enp3s0 -p tcp --dport 445 -d 192.168.5.103 -j ACCEPT
# Forward traffic on port 52223 on LAN to remote-cube on tun0 and port 22
-A FORWARD -i enp3s0 -o tun0 -p tcp --dport 52223 -s 192.168.5.1 -j ACCEPT
# Forward to any
-A FORWARD -s 10.8.0.0/16 -d 192.168.0.0/16 -i tun0 -o enp3s0 -m conntrack --ctstate NEW -j ACCEPT
-A FORWARD -s 192.168.0.0/16 -d 10.8.0.0/16 -i enp3s0 -o tun0 -m conntrack --ctstate NEW -j ACCEPT
COMMIT
*nat
# Forward Samba to jay-c (virtual ip for tracking) coming from remote-cube
-A PREROUTING -s 10.8.0.0/24 -p tcp --dport 139 -j DNAT --to-destination 192.168.5.103:139
-A PREROUTING -s 10.8.0.0/24 -p tcp --dport 445 -j DNAT --to-destination 192.168.5.103:445
# Forward traffic on port 52223 on LAN to remote-cube on tun0 and port 22
-A PREROUTING -s 192.168.0.0/16 -p tcp --dport 52223 -j DNAT --to-destination 10.8.0.4:22
# Forward to any, make it look like it's coming from this server
-A POSTROUTING -s 10.8.0.0/16 -o enp3s0 -j MASQUERADE
# Forward traffic on port 52223 on LAN to remote-cube on tun0 and port 22
-A POSTROUTING -s 192.168.0.0/16 -o tun0 -j MASQUERADE
COMMIT