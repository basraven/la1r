{# Based on https://github.com/kylemanna/docker-openvpn/blob/master/bin/ovpn_genconfig #}
server 10.8.0.0 255.255.255.0
verb 3
key /etc/openvpn/openvpn-ca/pki/private/{{openvpn_server_url}}.key
ca /etc/openvpn/openvpn-ca/pki/ca.crt
cert /etc/openvpn/openvpn-ca/pki/issued/{{openvpn_server_url}}.crt
dh /etc/openvpn/openvpn-ca/pki/dh.pem
tls-auth /etc/openvpn/openvpn-ca/pki/ta.key
crl-verify /etc/openvpn/openvpn-ca/pki/crl.pem
key-direction 0
keepalive 10 60
persist-key
persist-tun
topology subnet
data-ciphers AES-256-GCM:AES-128-GCM:BF-CBC

proto udp 
port {{openvpn_port}} 
dev tun0
status /var/log/openvpn/openvpn-status.log
log-append /var/log/openvpn/openvpn.log
# management 0.0.0.0 33555 # very insecure

client-config-dir /etc/openvpn/client-configs
ifconfig-pool-persist /var/log/openvpn/ipp.txt

user nobody
group nogroup
client-to-client
comp-lzo no

status-version 2
# duplicate-cn # disabled because we want to have a static IP pool

